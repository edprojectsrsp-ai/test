FROM python:3.12-slim

WORKDIR /srv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AI_SERVICE_URL=http://127.0.0.1:8002

COPY project-brain-backend/requirements.txt /tmp/backend-requirements.txt
COPY ai_service/requirements.txt /tmp/ai-requirements.txt
RUN pip install --no-cache-dir -r /tmp/backend-requirements.txt \
    && pip install --no-cache-dir -r /tmp/ai-requirements.txt

COPY project-brain-backend /srv/project-brain-backend
COPY ai_service /srv/ai_service
COPY _scheduling_module /srv/_scheduling_module
COPY scripts/start-render.sh /srv/start-render.sh

RUN chmod +x /srv/start-render.sh

EXPOSE 8000

CMD ["/srv/start-render.sh"]
