# ---- role -------------------------------------------------------------
# edge  = plant PC: cameras, inference, live view, recording, training
# cloud = hosted dashboard: violations feed + sync receiver, no ML at all
PPE_ROLE=edge

PPE_PORT=8004
PPE_DEVICE=cpu
PPE_BOOT_MODEL_KEY=nduka1999
# The control-room page is served from Vercel but talks to this agent on
# http://127.0.0.1:8004, so the Vercel origin must be allowed here.
PPE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PPE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/project_brain
# PPE_BASE_WEIGHTS=yolo11n.pt
# PPE_ACTIVE_WEIGHTS=ppe_active.pt

# ---- cloud sync, edge side (outbound only) ----------------------------
# Where to push violations, and the credential this plant PC pushes with.
# The installer writes these; the cloud must carry the matching entry in
# PPE_SYNC_AGENTS.
# PPE_SYNC_URL=https://project-brain-ppe-lite.onrender.com
# PPE_AGENT_ID=rsp-plant-01
# PPE_AGENT_TOKEN=change-me

# Manual push is the default: nothing leaves the plant until someone presses
# the button. Set to 1 only if you want the 4-hourly timer as well.
PPE_AUTO_SYNC=0
PPE_SYNC_INTERVAL_S=14400
PPE_SYNC_BATCH=100
PPE_SYNC_THUMB_WIDTH=640
PPE_SYNC_THUMB_QUALITY=75

# ---- cloud sync, cloud side -------------------------------------------
# Comma-separated "agentid:token" pairs. Hashed into sync_agents at boot.
# PPE_SYNC_AGENTS=rsp-plant-01:change-me
# PPE_CLOUD_RETENTION_DAYS=90
