FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PPE_ROOT=/tmp/ppe \
    PPE_BASE_WEIGHTS=/tmp/ppe/data/weights/zoo/hexmon-vyra.pt \
    PPE_BASE_WEIGHTS_FALLBACK=/tmp/ppe/data/weights/zoo/snehil-demo.pt \
    YOLO_CONFIG_DIR=/tmp/Ultralytics \
    PIP_DEFAULT_TIMEOUT=1000 \
    PIP_RETRIES=10

RUN apt-get update \
    && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/ppe

COPY ppe-camera/backend/requirements.render.txt /tmp/ppe-requirements.txt
RUN pip install --no-cache-dir torch torchvision \
        --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r /tmp/ppe-requirements.txt

COPY ppe-camera/backend/app /srv/ppe/app
COPY ppe-camera/backend/scripts/start-render.sh /srv/ppe/start-render.sh
COPY ppe-camera/data/weights/zoo/snehil-demo.pt /opt/ppe-models/snehil-demo.pt
COPY ppe-camera/data/weights/zoo/voxdroid-enterprise.pt /opt/ppe-models/voxdroid-enterprise.pt
COPY ppe-camera/data/weights/zoo/nduka1999.onnx /opt/ppe-models/nduka1999.onnx
COPY ppe-camera/data/weights/zoo/hexmon-vyra.pt /opt/ppe-models/hexmon-vyra.pt

RUN chmod +x /srv/ppe/start-render.sh

EXPOSE 8004

CMD ["/srv/ppe/start-render.sh"]
